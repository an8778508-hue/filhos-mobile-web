# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VS Code (uncomment if you don't want to share VS Code settings)
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
*.g.dart
*.freezed.dart
*.gr.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# Secrets — keystores, signing properties, env files. These must NEVER be
# committed. CI injects them from secrets at build time.
**/key.properties
**/*.keystore
**/*.jks
**/*.p12
**/*.pem
*.mobileprovision
.env
.env.*
secrets/

# Firebase config — per-flavor identity. Inject from CI; do not commit.
# Existing committed copies are documented in specs/review.md §1 and require
# a separate `git rm --cached` + history scrub to be removed safely.
**/google-services.json
ios/config/**/GoogleService-Info.plist
ios/Runner/GoogleService-Info.plist

# Playwright harness — committed source, ignored runtime artefacts.
# `/build/` above already excludes the per-flavor web bundles the harness
# produces under build/web-parents/ and build/web-professores/.
playwright/node_modules/
playwright/artifacts/
playwright/test-results/
playwright/playwright-report/
playwright/.cache/
playwright/*.tsbuildinfo

# Stray nested clone — must not be embedded as a gitlink
Evunity-mobile/
